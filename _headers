# Cloudflare static-asset response headers.
#
# Note: when several patterns match a request, Cloudflare merges their headers
# and comma-joins duplicates. Two rules setting Cache-Control on the same path
# would produce an invalid header, so each path gets exactly one rule.
#
# Image filenames are stable step numbers rather than content hashes, so
# re-capturing a screenshot reuses the same URL and those caches stay short.
# Videos are the opposite -- build.py names them with a content hash, so the
# URL changes whenever the file does and they can be cached indefinitely.

/img/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=300

/vid/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
